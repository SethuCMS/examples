# Copy this file to .env.local (cp env.example .env.local) and fill in. .env.local is git-ignored.
# These names have NO NEXT_PUBLIC_ prefix on purpose: Next.js therefore keeps
# them on the server and never puts them in the browser bundle.

# Address of the SethuCMS gateway (http is allowed for localhost only).
SETHUCMS_URL=http://127.0.0.1:8080

# Admin token printed ONCE on the gateway's first start.
SETHUCMS_TOKEN=paste-the-admin-token-here

# Optional: allow plain http to a non-local gateway (tokens travel unencrypted!).
# SETHUCMS_ALLOW_INSECURE_HTTP=true
